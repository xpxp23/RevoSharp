<ui:FluentWindow x:Class="RevoSharp.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:RevoSharp.App.ViewModels"
        xmlns:conv="clr-namespace:RevoSharp.App.Converters"
        mc:Ignorable="d"
        Title="RevoSharp v2.4 Pro - 深度软件卸载与安装监控"
        Height="800" Width="1280"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <conv:NullToBoolConverter x:Key="NullToBool" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVisInv" Invert="True" />
        <conv:CountToVisibilityConverter x:Key="EmptyCountToVis" Invert="True" />
        <conv:AppIconConverter x:Key="AppIconConv" />

        <Style x:Key="RightAlignedCellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="CenterAlignedCellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CategoryPillRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,2,6,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource RevoPillSelectedBackgroundBrush}" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource RevoPillSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </ui:FluentWindow.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Window TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="RevoSharp v2.4 Pro"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     Icon="{ui:SymbolIcon Shield24}">
            <ui:TitleBar.Header>
                <TextBlock Text="NTFS MFT 全盘检索 · 数字签名护栏 · 卸载问卷拦截 · 猎犬模式 · ETW 安装监控"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 2. Responsive Action Command Bar + Quick Filter Pills -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="16,12"
                Margin="16,0,16,10"
                CornerRadius="8">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                        <!-- Search Box -->
                        <ui:TextBox Width="250"
                                    PlaceholderText="搜索软件名称、发行商、版本或路径..."
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Icon="{ui:SymbolIcon Search24}"
                                    ClearButtonEnabled="True" />

                        <!-- Include Windows Store Apps Toggle -->
                        <CheckBox Content="含商店应用"
                                  IsChecked="{Binding IncludeWindowsApps}"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0"
                                  FontSize="12"
                                  ToolTip="同时扫描并展示 Windows 商店应用 (UWP / MSIX)" />

                        <!-- Block Uninstaller Survey Popups Toggle -->
                        <CheckBox Content="拦截卸载问卷"
                                  IsChecked="{Binding BlockUninstallSurveyWebpages}"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0"
                                  FontSize="12"
                                  ToolTip="卸载期间自动检测并阻断原厂卸载程序退场时拉起的浏览器调查问卷网页弹窗" />
                    </StackPanel>

                    <!-- Structured Action Bar -->
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ui:Button Content="卸载并清残留"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Appearance="Primary"
                                   Margin="0,2,6,2"
                                   IsEnabled="{Binding SelectedApp, Converter={StaticResource NullToBool}}"
                                   Click="OnUninstallClick"
                                   ToolTip="支持单选或多选队列卸载：运行原厂卸载器后汇总执行深度逆向残留扫描" />

                        <ui:Button Content="静默快卸"
                                   Icon="{ui:SymbolIcon Flash24}"
                                   Margin="0,2,6,2"
                                   IsEnabled="{Binding SelectedApp, Converter={StaticResource NullToBool}}"
                                   Click="OnQuickUninstallClick"
                                   ToolTip="自动识别 Inno/NSIS/Burn/MSI 静默参数极速卸载并合并清理残留" />

                        <ui:Button Content="强制卸载"
                                   Icon="{ui:SymbolIcon Wrench24}"
                                   Margin="0,2,8,2"
                                   Click="OnForcedUninstallClick"
                                   ToolTip="针对已卸载遗留残余、卸载器损坏或未登记的软件按名称/路径深度清理" />

                        <Border Width="1" Height="20"
                                Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                VerticalAlignment="Center"
                                Margin="2,2,8,2" />

                        <ui:Button Content="监视安装"
                                   Icon="{ui:SymbolIcon Record24}"
                                   Margin="0,2,6,2"
                                   Click="OnMonitorInstallClick"
                                   ToolTip="启动 ETW 内核追踪与注册表快照差分，记录新软件安装的完整变更" />

                        <ui:Button Content="猎犬模式"
                                   Icon="{ui:SymbolIcon Target24}"
                                   Margin="0,2,6,2"
                                   Click="OnHunterModeClick"
                                   ToolTip="进入桌面准星猎杀模式，支持瞄准任意活动窗口或拖入快捷方式" />

                        <ui:Button Content="工具与设置"
                                   Icon="{ui:SymbolIcon Apps24}"
                                   Margin="0,2,6,2"
                                   Click="OnToolkitClick"
                                   ToolTip="开机自启动管理器、多级备份还原中心、安装日志库、右键菜单集成与安全白名单设置" />

                        <ui:Button Content="{Binding CurrentThemeButtonText}"
                                   Icon="{ui:SymbolIcon Color24}"
                                   Margin="0,2,6,2"
                                   Command="{Binding CycleThemeCommand}"
                                   ToolTip="一键切换界面主题并自动记忆：深色 (Dark) / 浅色 (Light) / 跟随系统 (System)" />

                        <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Margin="0,2,0,2"
                                   Command="{Binding LoadAppsCommand}"
                                   ToolTip="刷新已安装软件列表" />
                    </WrapPanel>
                </DockPanel>

                <!-- Quick Category Filter Pills (Fluent SymbolIcon + Counts) -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="分类筛选：" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,8,0" />

                        <RadioButton IsChecked="True" Style="{StaticResource CategoryPillRadioStyle}" GroupName="MainAppCat" Tag="全部" Checked="OnAppCategoryFilterChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Apps24" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalAppCount, StringFormat='全部程序 ({0})'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource CategoryPillRadioStyle}" GroupName="MainAppCat" Tag="近期新装" Checked="OnAppCategoryFilterChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="13" Foreground="{DynamicResource RevoAccentCyanBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RecentAppCount, StringFormat='近期新装 ({0})'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource CategoryPillRadioStyle}" GroupName="MainAppCat" Tag="已追踪" Checked="OnAppCategoryFilterChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Record24" FontSize="13" Foreground="{DynamicResource RevoAccentGreenBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TracedAppCount, StringFormat='已追踪日志 ({0})'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource CategoryPillRadioStyle}" GroupName="MainAppCat" Tag="桌面软件" Checked="OnAppCategoryFilterChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Document24" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DesktopAppCount, StringFormat='桌面软件 ({0})'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource CategoryPillRadioStyle}" GroupName="MainAppCat" Tag="商店应用" Checked="OnAppCategoryFilterChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Box24" FontSize="13" Foreground="{DynamicResource RevoAccentPurpleBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StoreAppCount, StringFormat='商店应用 ({0})'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>

                    <ui:Button Grid.Column="1"
                               Content="详情检视栏"
                               Icon="{ui:SymbolIcon Info24}"
                               Appearance="Secondary"
                               FontSize="12"
                               Padding="10,4"
                               Command="{Binding ToggleInspectorCommand}"
                               ToolTip="展开或收起底部软件路径与注册表详情面板" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Installed Apps DataGrid + Floating Multi-Selection Action Bar -->
        <Border Grid.Row="2"
                Margin="16,0,16,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="2">
            <Grid>
                <ui:DataGrid x:Name="AppsDataGrid"
                             ItemsSource="{Binding Apps}"
                             SelectedItem="{Binding SelectedApp}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             IsReadOnly="True"
                             SelectionMode="Extended"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             SelectionChanged="OnAppsDataGridSelectionChanged"
                             MouseDoubleClick="OnDataGridDoubleClick">
                    <ui:DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="卸载并清理残留 (支持多选队列)" Click="OnUninstallClick" />
                            <MenuItem Header="静默快速卸载 (支持多选队列)" Click="OnQuickUninstallClick" />
                            <MenuItem Header="仅深度扫描残留 (跳过原厂卸载程序)" Click="OnDirectScanResidualsClick" />
                            <Separator />
                            <MenuItem Header="打开安装所在目录" Command="{Binding OpenLocationCommand}" />
                            <MenuItem Header="在注册表编辑器 (RegEdit) 中定位" Command="{Binding OpenRegistryKeyCommand}" />
                            <MenuItem Header="复制安装目录路径" Command="{Binding CopyInstallLocationCommand}" />
                            <MenuItem Header="复制注册表项路径" Command="{Binding CopyRegistryKeyPathCommand}" />
                            <MenuItem Header="复制原厂卸载命令行" Command="{Binding CopyUninstallStringCommand}" />
                            <Separator />
                            <MenuItem Header="在浏览器中搜索该软件信息" Command="{Binding SearchOnlineInfoCommand}" />
                        </ContextMenu>
                    </ui:DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- App Icon (Non-blocking CachedIcon + Background Preloader) + Name + Recent/UWP Badges -->
                        <DataGridTemplateColumn Header="软件名称" Width="*" MinWidth="290" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="5"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <Grid>
                                                <Image x:Name="RowAppIcon"
                                                       Source="{Binding CachedIcon, Converter={StaticResource AppIconConv}}"
                                                       Width="18" Height="18"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <ui:SymbolIcon Symbol="Apps24"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding Source, ElementName=RowAppIcon, Converter={StaticResource NullToVisInv}}" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Margin="8,0,6,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}" />

                                        <Border Grid.Column="2" Background="{DynamicResource RevoTagBlueBgBrush}" BorderBrush="{DynamicResource RevoTagBlueBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1"
                                                VerticalAlignment="Center" Margin="0,0,4,0"
                                                Visibility="{Binding IsRecentlyInstalled, Converter={StaticResource BoolToVis}}"
                                                ToolTip="近 14 天内新安装或更新的软件">
                                            <TextBlock Text="近期新装" FontSize="10" Foreground="{DynamicResource RevoAccentCyanBrush}" FontWeight="SemiBold" />
                                        </Border>

                                        <Border Grid.Column="3" Background="{DynamicResource RevoTagPurpleBgBrush}" BorderBrush="{DynamicResource RevoTagPurpleBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1"
                                                VerticalAlignment="Center" Margin="0,0,4,0"
                                                Visibility="{Binding IsWindowsApp, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="商店应用" FontSize="10" Foreground="{DynamicResource RevoAccentPurpleBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="版本" Binding="{Binding VersionDisplay}" SortMemberPath="DisplayVersion" Width="125" />
                        <DataGridTextColumn Header="发行商" Binding="{Binding PublisherDisplay}" SortMemberPath="Publisher" Width="190" />

                        <DataGridTextColumn Header="占用大小"
                                            Binding="{Binding FormattedSize}"
                                            SortMemberPath="EstimatedSizeInBytes"
                                            ElementStyle="{StaticResource RightAlignedCellTextStyle}"
                                            Width="105" />

                        <DataGridTextColumn Header="安装日期"
                                            Binding="{Binding InstallDateDisplay}"
                                            SortMemberPath="InstallDate"
                                            ElementStyle="{StaticResource CenterAlignedCellTextStyle}"
                                            Width="105" />

                        <DataGridTextColumn Header="架构"
                                            Binding="{Binding Architecture}"
                                            ElementStyle="{StaticResource CenterAlignedCellTextStyle}"
                                            Width="75" />

                        <DataGridTemplateColumn Header="监控日志" Width="95" SortMemberPath="HasTraceLog">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <ui:Badge Content="已追踪" Appearance="Success" Visibility="{Binding HasTraceLog, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </ui:DataGrid>

                <!-- Floating Multi-Selection Action Bar (Smoothly appears when >= 2 apps are selected) -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,18"
                        Padding="18,10"
                        CornerRadius="10"
                        Background="{DynamicResource RevoFloatingBarBgBrush}"
                        BorderBrush="{DynamicResource RevoFloatingBarBorderBrush}"
                        BorderThickness="1.5"
                        Visibility="{Binding IsMultiSelectionActive, Converter={StaticResource BoolToVis}}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.45" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Foreground="{DynamicResource RevoAccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding MultiSelectionSummaryText}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <ui:Button Content="一键批量卸载"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Appearance="Primary"
                                   Padding="12,5"
                                   Margin="0,0,8,0"
                                   Click="OnUninstallClick" />
                        <ui:Button Content="批量静默快卸"
                                   Icon="{ui:SymbolIcon Flash24}"
                                   Appearance="Secondary"
                                   Padding="12,5"
                                   Margin="0,0,8,0"
                                   Click="OnQuickUninstallClick" />
                        <ui:Button Content="取消多选"
                                   Appearance="Transparent"
                                   Padding="10,5"
                                   Click="OnClearMultiSelectionClick" />
                    </StackPanel>
                </Border>

                <!-- Empty State Overlay -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding Apps.Count, Converter={StaticResource EmptyCountToVis}}">
                    <ui:SymbolIcon Symbol="Search24" FontSize="40" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="未找到匹配的已安装程序" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="如需清理已卸载软件的遗留残余，请点击上方「强制卸载」向导" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Loading Overlay -->
                <ui:ProgressRing IsIndeterminate="True"
                                 Width="52" Height="52"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- 4. Collapsible Bottom App Details Inspector Bar (Responsive Star-Width Grid, No Premature 420px Truncation) -->
        <Border Grid.Row="3"
                Margin="16,0,16,10"
                Padding="14,10"
                CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVis}}">
            <Grid Visibility="{Binding SelectedApp, Converter={StaticResource NullToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Install Location -->
                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,18,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" FontSize="14" Foreground="{DynamicResource RevoAccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="安装目录：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding SelectedApp.InstallLocationDisplay}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   FontFamily="Consolas, Cascadia Code, Microsoft YaHei UI"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedApp.InstallLocationDisplay}" />
                    </Grid>

                    <!-- Registry Path -->
                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Code24" FontSize="14" Foreground="{DynamicResource RevoAccentPurpleBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="注册表项：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding SelectedApp.RegistryKeyPath}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   FontFamily="Consolas, Cascadia Code, Microsoft YaHei UI"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedApp.RegistryKeyPath}" />
                    </Grid>

                    <!-- Uninstall Command -->
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Wrench24" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="卸载命令：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding SelectedApp.UninstallString}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontFamily="Consolas, Cascadia Code, Microsoft YaHei UI"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedApp.UninstallString}" />
                    </Grid>
                </Grid>

                <!-- Quick Inspector Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ui:Button Content="打开目录"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               FontSize="12"
                               Padding="10,5"
                               Margin="0,0,6,0"
                               Command="{Binding OpenLocationCommand}" />
                    <ui:Button Content="定位注册表"
                               Icon="{ui:SymbolIcon Code24}"
                               FontSize="12"
                               Padding="10,5"
                               Margin="0,0,6,0"
                               Command="{Binding OpenRegistryKeyCommand}" />
                    <ui:Button Content="仅扫残留"
                               Icon="{ui:SymbolIcon Broom24}"
                               FontSize="12"
                               Padding="10,5"
                               Click="OnDirectScanResidualsClick"
                               ToolTip="跳过原厂卸载器，直接扫描该程序关联的注册表与目录残留" />
