<ui:FluentWindow x:Class="RevoSharp.App.Views.ResidualReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:RevoSharp.Core.Models;assembly=RevoSharp.Core"
        xmlns:conv="clr-namespace:RevoSharp.App.Converters"
        mc:Ignorable="d"
        Title="深度残留审查与一键安全清理"
        Height="760" Width="1180"
        MinHeight="540" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <conv:CountToVisibilityConverter x:Key="EmptyCountToVis" Invert="True" />

        <!-- Modern Segmented Pill Style for Category & View Mode RadioButtons -->
        <Style x:Key="SegmentedFilterRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#3A0080FF" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#0088FF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="RevoSharp 深度残留审查与多级安全备份"
                     ShowMaximize="True"
                     ShowMinimize="False"
                     Icon="{ui:SymbolIcon Broom24}" />

        <!-- 2. Header & Action Filter Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Margin="16,0,16,10" Padding="16,12" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: App Name & Category Segmented Pills -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameTextBlock" Text="程序残留全景清单" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />

                        <RadioButton Content="{Binding TotalCount, StringFormat='全部 ({0})'}" IsChecked="True"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="CatFilter" Tag="全部" Checked="OnCategoryFilterChecked" />
                        <RadioButton Content="{Binding RegCount, StringFormat='注册表 ({0})'}"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="CatFilter" Tag="注册表" Checked="OnCategoryFilterChecked" />
                        <RadioButton Content="{Binding FileCount, StringFormat='文件与目录 ({0})'}"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="CatFilter" Tag="文件与目录" Checked="OnCategoryFilterChecked" />
                        <RadioButton Content="{Binding ShortcutCount, StringFormat='快捷方式 ({0})'}"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="CatFilter" Tag="快捷方式" Checked="OnCategoryFilterChecked" />
                        <RadioButton Content="{Binding ServiceAndTaskCount, StringFormat='服务与任务 ({0})'}"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="CatFilter" Tag="服务与任务" Checked="OnCategoryFilterChecked" />
                    </WrapPanel>

                    <!-- Scan Mode & Rescan -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="扫描深度:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <ComboBox x:Name="ScanModeComboBox" SelectedIndex="1" Width="125" Margin="0,0,8,0" SelectionChanged="OnScanModeChanged">
                            <ComboBoxItem Content="安全 (Safe)" />
                            <ComboBoxItem Content="中等 (推荐)" />
                            <ComboBoxItem Content="高级 (深度特征)" />
                        </ComboBox>
                        <ui:Button Content="重新扫描" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding ExecuteScanCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Row 1: Search Filter, View Mode Switch & Batch Select -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0"
                                PlaceholderText="过滤路径、键值名称或命中原因..."
                                Text="{Binding PathFilterText, UpdateSourceTrigger=PropertyChanged}"
                                Icon="{ui:SymbolIcon Search24}"
                                ClearButtonEnabled="True" />

                    <!-- View Mode Switch: Flat Table vs Hierarchical Tree (Revo / BCU style) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <RadioButton Content="📋 扁平明细" IsChecked="True"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="ViewModeSwitch" Tag="Flat" Checked="OnViewModeChecked" />
                        <RadioButton Content="🌲 树形层级"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="ViewModeSwitch" Tag="Tree" Checked="OnViewModeChecked" />

                        <ui:Button Content="展开全部"
                                   Command="{Binding ExpandAllTreesCommand}"
                                   Visibility="{Binding IsTreeViewMode, Converter={StaticResource BoolToVis}}"
                                   Margin="4,0,6,0" />
                        <ui:Button Content="折叠全部"
                                   Command="{Binding CollapseAllTreesCommand}"
                                   Visibility="{Binding IsTreeViewMode, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="仅选高置信度 (推荐)" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" Command="{Binding SelectHighOnlyCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="全选" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="全不选" Command="{Binding DeselectAllCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Central Dual-Mode Content Area (Flat DataGrid OR Split Hierarchical TreeView) -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Margin="16,0,16,10" CornerRadius="8" Padding="2">
            <Grid>
                <!-- Mode A: Flat Direct DataGrid (with Single-Click CheckBox TemplateColumn) -->
                <ui:DataGrid ItemsSource="{Binding DisplayedResiduals}"
                             SelectedItem="{Binding SelectedResidual}"
                             Visibility="{Binding IsTreeViewMode, Converter={StaticResource InvBoolToVis}}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             IsReadOnly="True"
                             SelectionMode="Single"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column">
                    <ui:DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="打开所在文件夹 / 定位位置" Command="{Binding OpenItemLocationCommand}" />
                            <MenuItem Header="在注册表编辑器 (RegEdit) 中打开" Command="{Binding OpenInRegEditCommand}" />
                            <Separator />
                            <MenuItem Header="复制完整路径与键值" Command="{Binding CopyPathCommand}" />
                        </ContextMenu>
                    </ui:DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- Single-click immediate CheckBox column -->
                        <DataGridTemplateColumn Header="选择" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="类别" Width="110" SortMemberPath="TypeDisplay" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#220088FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeDisplay}" FontSize="11" Foreground="#88CCFF" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="置信度" Width="125" SortMemberPath="Confidence" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <ui:Badge Content="{Binding ConfidenceDisplay}" Appearance="Success"
                                                  Visibility="{Binding IsHighConfidence, Converter={StaticResource BoolToVis}}" />
                                        <ui:Badge Content="{Binding ConfidenceDisplay}" Appearance="Caution"
                                                  Visibility="{Binding IsMediumConfidence, Converter={StaticResource BoolToVis}}" />
                                        <ui:Badge Content="{Binding ConfidenceDisplay}" Appearance="Danger"
                                                  Visibility="{Binding IsLowConfidence, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="完整残留路径 / 注册表键与值名称" Binding="{Binding FullDisplayPath}" Width="*" MinWidth="320" IsReadOnly="True" />

                        <DataGridTextColumn Header="大小" Binding="{Binding FormattedSize}" SortMemberPath="SizeInBytes" Width="90" IsReadOnly="True" />

                        <DataGridTextColumn Header="命中原因" Binding="{Binding Reason}" Width="220" IsReadOnly="True" />
                    </DataGrid.Columns>
                </ui:DataGrid>

                <!-- Mode B: Split Hierarchical TreeView (Registry Tree + FileSystem Tree with Tri-State Cascading) -->
                <Grid Visibility="{Binding IsTreeViewMode, Converter={StaticResource BoolToVis}}" Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Registry Hierarchical Tree -->
                    <Border Grid.Column="0" Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="6" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="🔑 注册表残留层级树 (支持父子三态联动勾选)" FontWeight="SemiBold" FontSize="13" Margin="4,0,0,8" />
                            <TreeView Grid.Row="1" ItemsSource="{Binding RegistryTreeNodes}" BorderThickness="0" Background="Transparent">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type models:RegistryTreeNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <CheckBox IsThreeState="True"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding IconGlyph}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <Border Background="#220088FF" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                                    Visibility="{Binding IsMatched, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding MatchReason}" FontSize="10" Foreground="#88CCFF" />
                                            </Border>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

                    <!-- Right: FileSystem Hierarchical Tree -->
                    <Border Grid.Column="2" Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="6" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📁 文件、目录与计划任务层级树 (支持父子三态联动勾选)" FontWeight="SemiBold" FontSize="13" Margin="4,0,0,8" />
                            <TreeView Grid.Row="1" ItemsSource="{Binding FileSystemTreeNodes}" BorderThickness="0" Background="Transparent">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type models:FileSystemTreeNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <CheckBox IsThreeState="True"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding IconGlyph}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <Border Background="#2244DD88" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                                    Visibility="{Binding IsMatched, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding MatchReason}" FontSize="10" Foreground="#88EEAA" />
                                            </Border>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Empty State Overlay -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding DisplayedResiduals.Count, Converter={StaticResource EmptyCountToVis}}">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="42" Foreground="#44DD88" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="当前筛选条件下未发现残留项" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="原厂卸载程序已清理干净，或可切换至“高级 (深度特征)”级别重新扫描" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Loading Overlay -->
                <Border Background="#AA121418" CornerRadius="8"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing Width="48" Height="48" IsIndeterminate="True" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 4. Footer Clean Action Bar with Multi-Level Safety Options -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0">
                    <CheckBox Content="创建系统还原点" IsChecked="{Binding CreateRestorePoint}" Margin="0,0,12,0" FontSize="12"
                              ToolTip="清理前调用 WMI 创建 Windows 系统还原点" />
                    <CheckBox Content="占用文件重启后删除" IsChecked="{Binding ScheduleLockedOnReboot}" FontSize="12"
                              ToolTip="若残留文件或子目录被后台进程占用无法移入回收站，则自动以后序遍历注册在下次重启时由内核删除" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="放弃并关闭" Margin="0,0,10,0" Click="OnCancelClick" />
                    <ui:Button Content="安全备份并清除所选"
                               Icon="{ui:SymbolIcon Checkmark24}"
                               Appearance="Primary"
                               Click="OnCleanAllClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
