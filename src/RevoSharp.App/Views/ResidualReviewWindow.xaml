<ui:FluentWindow x:Class="RevoSharp.App.Views.ResidualReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:RevoSharp.Core.Models;assembly=RevoSharp.Core"
        xmlns:conv="clr-namespace:RevoSharp.App.Converters"
        mc:Ignorable="d"
        Title="深度残留审查与安全清理 (v2.4 Pro)"
        Height="780" Width="1260"
        MinHeight="540" MinWidth="920"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <conv:CountToVisibilityConverter x:Key="EmptyCountToVis" Invert="True" />
        <conv:StringToSymbolRegularConverter x:Key="SymbolConv" />

        <Style x:Key="RightAlignedCellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <!-- Modern Segmented Pill Style for Category & View Mode RadioButtons -->
        <Style x:Key="SegmentedFilterRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,2,6,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource RevoPillSelectedBackgroundBrush}" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource RevoPillSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="深度残留审查与安全备份清理 (v2.4 Pro)"
                     ShowMaximize="True"
                     ShowMinimize="False"
                     Icon="{ui:SymbolIcon Broom24}">
            <ui:TitleBar.Header>
                <TextBlock Text="NTFS MFT 全盘检索 · 数字签名防误删护栏 · Restart Manager 批量解锁 · 原位合成 .reg"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 2. Header & Action Filter Toolbar -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Margin="16,0,16,10"
                Padding="16,12"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: App Name & Category Segmented Pills -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameTextBlock" Text="程序残留全景清单" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />

                        <RadioButton Content="{Binding TotalCount, StringFormat='全部 ({0})'}" IsChecked="True"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="CatFilter" Tag="全部" Checked="OnCategoryFilterChecked" />
                        <RadioButton Content="{Binding RegCount, StringFormat='注册表 ({0})'}"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="CatFilter" Tag="注册表" Checked="OnCategoryFilterChecked" />
                        <RadioButton Content="{Binding FileCount, StringFormat='文件与目录 ({0})'}"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="CatFilter" Tag="文件与目录" Checked="OnCategoryFilterChecked" />
                        <RadioButton Content="{Binding ShortcutCount, StringFormat='快捷方式 ({0})'}"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="CatFilter" Tag="快捷方式" Checked="OnCategoryFilterChecked" />
                        <RadioButton Content="{Binding ServiceAndTaskCount, StringFormat='服务/驱动/任务 ({0})'}"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="CatFilter" Tag="服务与任务" Checked="OnCategoryFilterChecked" />
                        <RadioButton Content="{Binding ExtensionAndEnvCount, StringFormat='扩展/协议/环境 ({0})'}"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="CatFilter" Tag="扩展与环境" Checked="OnCategoryFilterChecked" />
                        <RadioButton Content="{Binding LockedItemCount, StringFormat='占用锁定 ({0})'}"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     Visibility="{Binding HasLockedItems, Converter={StaticResource BoolToVis}}"
                                     GroupName="CatFilter" Tag="占用锁定" Checked="OnCategoryFilterChecked" />
                    </WrapPanel>

                    <!-- Scan Mode, Unlock Handle Button & Rescan -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="一键解除进程占用"
                                   Icon="{ui:SymbolIcon Key24}"
                                   Appearance="Caution"
                                   Margin="0,0,10,0"
                                   Visibility="{Binding HasLockedItems, Converter={StaticResource BoolToVis}}"
                                   Command="{Binding UnlockAllLockedItemsCommand}"
                                   ToolTip="通过 Windows Restart Manager 终止占用进程或平滑重启 Explorer 以立即释放被锁定的文件与外壳扩展 DLL" />

                        <TextBlock Text="扫描深度:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <ComboBox x:Name="ScanModeComboBox" SelectedIndex="1" Width="150" Margin="0,0,8,0" SelectionChanged="OnScanModeChanged">
                            <ComboBoxItem Content="安全 (Safe)" />
                            <ComboBoxItem Content="中等 (推荐)" />
                            <ComboBoxItem Content="高级 (含 MFT 全盘)" />
                        </ComboBox>
                        <ui:Button Content="重新扫描" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding ExecuteScanCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Row 1: Search Filter, View Mode Switch & Batch Select -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0"
                                PlaceholderText="过滤路径、键值、占用进程或命中原因..."
                                Text="{Binding PathFilterText, UpdateSourceTrigger=PropertyChanged}"
                                Icon="{ui:SymbolIcon Search24}"
                                ClearButtonEnabled="True" />

                    <!-- View Mode Switch: Flat Table vs Hierarchical Tree -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <RadioButton IsChecked="True"
                                     Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="ViewModeSwitch" Tag="Flat" Checked="OnViewModeChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentText24" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="扁平明细" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SegmentedFilterRadioStyle}"
                                     GroupName="ViewModeSwitch" Tag="Tree" Checked="OnViewModeChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Folder24" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="树形层级" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <ui:Button Content="展开全部"
                                   Command="{Binding ExpandAllTreesCommand}"
                                   Visibility="{Binding IsTreeViewMode, Converter={StaticResource BoolToVis}}"
                                   Margin="4,0,6,0" />
                        <ui:Button Content="折叠全部"
                                   Command="{Binding CollapseAllTreesCommand}"
                                   Visibility="{Binding IsTreeViewMode, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="仅选高置信度 (推荐)" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" Command="{Binding SelectHighOnlyCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="全选当前列表" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="全不选" Command="{Binding DeselectAllCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Central Dual-Mode Content Area (Flat DataGrid OR Split Hierarchical TreeView) -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Margin="16,0,16,10"
                CornerRadius="8"
                Padding="2">
            <Grid>
                <!-- Mode A: Flat Direct DataGrid (Refined Visual Hierarchy, Reduced Tag Noise) -->
                <ui:DataGrid ItemsSource="{Binding DisplayedResiduals}"
                             SelectedItem="{Binding SelectedResidual}"
                             Visibility="{Binding IsTreeViewMode, Converter={StaticResource InvBoolToVis}}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             IsReadOnly="True"
                             SelectionMode="Single"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column">
                    <ui:DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="打开所在文件夹 / 定位位置" Command="{Binding OpenItemLocationCommand}" />
                            <MenuItem Header="在注册表编辑器 (RegEdit) 中打开" Command="{Binding OpenInRegEditCommand}" />
                            <Separator />
                            <MenuItem Header="复制完整路径与键值" Command="{Binding CopyPathCommand}" />
                        </ContextMenu>
                    </ui:DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="选择" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Clean Icon + Text Category Column without heavy box border clutter -->
                        <DataGridTemplateColumn Header="类别" Width="116" SortMemberPath="TypeDisplay" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                        <ui:SymbolIcon Symbol="{Binding DisplayIcon, Converter={StaticResource SymbolConv}}"
                                                       FontSize="13.5"
                                                       Foreground="{DynamicResource RevoAccentCyanBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding TypeDisplay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="置信度" Width="125" SortMemberPath="Confidence" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <ui:Badge Content="{Binding ConfidenceDisplay}" Appearance="Success"
                                                  Visibility="{Binding IsHighConfidence, Converter={StaticResource BoolToVis}}" />
                                        <ui:Badge Content="{Binding ConfidenceDisplay}" Appearance="Caution"
                                                  Visibility="{Binding IsMediumConfidence, Converter={StaticResource BoolToVis}}" />
                                        <ui:Badge Content="{Binding ConfidenceDisplay}" Appearance="Danger"
                                                  Visibility="{Binding IsLowConfidence, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Segmented Syntax-Highlighted Path, Value & Restart Manager Lock Badge Column -->
                        <DataGridTemplateColumn Header="完整残留路径 / 注册表键与值名称" Width="*" MinWidth="360" SortMemberPath="FullDisplayPath" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,3" ToolTip="{Binding FullDisplayPath}">
                                        <TextBlock Text="{Binding PathPrefixDisplay}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontFamily="Consolas, Cascadia Code, Microsoft YaHei UI"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PathLeafDisplay}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Consolas, Cascadia Code, Microsoft YaHei UI"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource RevoTagBlueBgBrush}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasValueName, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ValueBadgeText}"
                                                       Foreground="{DynamicResource RevoAccentCyanBrush}"
                                                       FontFamily="Consolas, Cascadia Code, Microsoft YaHei UI"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding ValuePreviewText}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   FontFamily="Consolas, Cascadia Code, Microsoft YaHei UI"
                                                   FontSize="11.5"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasValuePreview, Converter={StaticResource BoolToVis}}" />
                                        <!-- Restart Manager File Lock Badge -->
                                        <Border Background="{DynamicResource RevoTagRedBgBrush}" BorderBrush="{DynamicResource RevoTagRedBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"
                                                ToolTip="该文件或目录当前被后台进程占用，点击上方「一键解除进程占用」或直接执行清理可自动释放">
                                            <TextBlock Text="{Binding LockedBySummary}"
                                                       Foreground="{DynamicResource RevoAccentRedBrush}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="大小"
                                            Binding="{Binding FormattedSize}"
                                            SortMemberPath="SizeInBytes"
                                            ElementStyle="{StaticResource RightAlignedCellTextStyle}"
                                            Width="95"
                                            IsReadOnly="True" />

                        <DataGridTemplateColumn Header="命中原因与归属" Width="250" SortMemberPath="Reason" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource RevoTagNeutralBgBrush}" CornerRadius="4" Padding="5,1" Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasSourceAppName, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding SourceAppName}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Reason}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Reason}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </ui:DataGrid>

                <!-- Mode B: Split Hierarchical TreeView (with 3-State Indeterminate CheckBox, Size, Confidence & Lock Badges) -->
                <Grid Visibility="{Binding IsTreeViewMode, Converter={StaticResource BoolToVis}}" Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Registry Hierarchical Tree -->
                    <Border Grid.Column="0" Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="6" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,8">
                                <ui:SymbolIcon Symbol="Code24" FontSize="15" Foreground="{DynamicResource RevoAccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="注册表残留层级树 (支持三态半选指示与父子保护)" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>

                            <TreeView x:Name="RegTreeView"
                                      Grid.Row="1"
                                      ItemsSource="{Binding RegistryTreeNodes}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="在注册表编辑器 (RegEdit) 中定位此节点" Click="OnRegTreeOpenLocationClick" />
                                        <MenuItem Header="复制节点完整路径" Click="OnRegTreeCopyPathClick" />
                                        <Separator />
                                        <MenuItem Header="展开全部节点" Command="{Binding ExpandAllTreesCommand}" />
                                        <MenuItem Header="折叠全部节点" Command="{Binding CollapseAllTreesCommand}" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type models:RegistryTreeNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2" Opacity="{Binding NodeOpacity}" ToolTip="{Binding FullPath}">
                                            <CheckBox IsThreeState="True"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ui:SymbolIcon Symbol="{Binding SymbolIconName, Converter={StaticResource SymbolConv}}"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource RevoAccentCyanBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Consolas, Cascadia Code, Microsoft YaHei UI"
                                                       FontSize="12" />
                                            <Border Background="{DynamicResource RevoTagAmberBgBrush}" BorderBrush="{DynamicResource RevoTagAmberBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                    Visibility="{Binding IsLowConfidence, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="低置信度" FontSize="10" Foreground="{DynamicResource RevoAccentAmberBrush}" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="{DynamicResource RevoTagBlueBgBrush}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                    Visibility="{Binding IsMatched, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding MatchReason}" FontSize="10" Foreground="{DynamicResource RevoAccentCyanTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>

                    <!-- Visible Grip Handle GridSplitter -->
                    <GridSplitter Grid.Column="1"
                                  Width="12"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  Cursor="SizeWE"
                                  ToolTip="左右拖动可调节注册表树与文件树的面板宽度">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Grid Background="Transparent">
                                    <Border Width="4" Height="42" CornerRadius="2"
                                            Background="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- Right: FileSystem Hierarchical Tree -->
                    <Border Grid.Column="2" Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="6" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,8">
                                <ui:SymbolIcon Symbol="Folder24" FontSize="15" Foreground="{DynamicResource RevoAccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="文件、目录与计划任务层级树 (含大小、占用与三态保护)" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>

                            <TreeView x:Name="FileTreeView"
                                      Grid.Row="1"
                                      ItemsSource="{Binding FileSystemTreeNodes}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="在资源管理器中打开所在位置" Click="OnFileTreeOpenLocationClick" />
                                        <MenuItem Header="复制节点完整路径" Click="OnFileTreeCopyPathClick" />
                                        <Separator />
                                        <MenuItem Header="展开全部节点" Command="{Binding ExpandAllTreesCommand}" />
                                        <MenuItem Header="折叠全部节点" Command="{Binding CollapseAllTreesCommand}" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type models:FileSystemTreeNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2" Opacity="{Binding NodeOpacity}" ToolTip="{Binding FullPath}">
                                            <CheckBox IsThreeState="True"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ui:SymbolIcon Symbol="{Binding SymbolIconName, Converter={StaticResource SymbolConv}}"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource RevoAccentGreenBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Consolas, Cascadia Code, Microsoft YaHei UI"
                                                       FontSize="12" />
                                            <Border Background="{DynamicResource RevoTagNeutralBgBrush}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                    Visibility="{Binding HasSize, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontFamily="Consolas, Microsoft YaHei UI" />
                                            </Border>
                                            <Border Background="{DynamicResource RevoTagAmberBgBrush}" BorderBrush="{DynamicResource RevoTagAmberBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                    Visibility="{Binding IsLowConfidence, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="低置信度" FontSize="10" Foreground="{DynamicResource RevoAccentAmberBrush}" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="{DynamicResource RevoTagRedBgBrush}" BorderBrush="{DynamicResource RevoTagRedBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                    Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding LockedBySummary}" FontSize="10" Foreground="{DynamicResource RevoAccentRedBrush}" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="{DynamicResource RevoTagGreenBgBrush}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                    Visibility="{Binding IsMatched, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding MatchReason}" FontSize="10" Foreground="{DynamicResource RevoAccentGreenTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Empty State Overlay -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding DisplayedResiduals.Count, Converter={StaticResource EmptyCountToVis}}">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="42" Foreground="{DynamicResource RevoAccentGreenBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="当前筛选条件下未发现残留项" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="原厂卸载程序已清理干净，或可切换至“高级 (含 MFT 全盘)”级别重新扫描" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Loading & Real-Time Progress Overlay -->
                <Border Background="{DynamicResource RevoOverlayMaskBrush}" CornerRadius="8"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="28,22"
                            MaxWidth="520"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:ProgressRing Width="42" Height="42" IsIndeterminate="True" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13.5"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <ProgressBar Width="380" Height="8"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding CleanProgressPercent}"
                                         Margin="0,12,0,6"
                                         Visibility="{Binding IsCleaningProgressVisible, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding CleanProgressDetail}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontFamily="Consolas, Microsoft YaHei UI"
                                       FontSize="11.5"
                                       MaxWidth="440"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding IsCleaningProgressVisible, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- 4. Footer Clean Action Bar with Multi-Level Safety Options -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0">
                    <CheckBox Content="创建系统还原点" IsChecked="{Binding CreateRestorePoint}" Margin="0,0,12,0" FontSize="12"
                              ToolTip="清理前调用 WMI 创建 Windows 系统还原点" />
                    <CheckBox Content="占用文件重启后删除" IsChecked="{Binding ScheduleLockedOnReboot}" FontSize="12"
                              ToolTip="若 Restart Manager 自动解锁后仍有核心驱动文件无法移入回收站，则自动以后序遍历注册在下次重启时由内核删除" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="放弃并关闭" Margin="0,0,10,0" Click="OnCancelClick" />
                    <ui:Button Content="安全备份并清除所选"
                               Icon="{ui:SymbolIcon Checkmark24}"
                               Appearance="Primary"
                               Click="OnCleanAllClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
