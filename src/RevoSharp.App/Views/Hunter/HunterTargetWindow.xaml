<Window x:Class="RevoSharp.App.Views.Hunter.HunterTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="猎犬模式准星"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True"
        AllowDrop="True"
        Drop="OnReticleFileDrop"
        DragOver="OnReticleDragOver"
        Width="96"
        Height="96"
        WindowStartupLocation="Manual"
        ToolTip="猎犬模式准星&#x0a;• 左键长按拖拽并释放到任意窗口/弹窗进行锁定（松手后准星自动归位）&#x0a;• 支持将桌面快捷方式 (.lnk) 或程序文件直接拖入准星&#x0a;• 右键长按拖动（或 Shift+左键拖动）可调整准星停靠位置&#x0a;• 按 Esc 键取消瞄准或退出猎犬模式 | 双击返回主界面">

    <Window.ContextMenu>
        <ContextMenu x:Name="ReticleContextMenu">
            <MenuItem Header="选择桌面快捷方式或文件进行猎杀..." Click="OnSelectFileTargetClick" />
            <MenuItem Header="返回主界面" Click="OnRestoreMainClick" />
            <Separator />
            <MenuItem Header="不透明度 100%" Click="OnOpacity100Click" />
            <MenuItem Header="不透明度 75%" Click="OnOpacity75Click" />
            <MenuItem Header="不透明度 50%" Click="OnOpacity50Click" />
            <Separator />
            <MenuItem Header="退出猎犬模式 (Esc)" Click="OnExitHunterClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Cursor="Hand" Width="96" Height="96">
        <!-- Outer Glow Ring (Centered in 96x96 so 14px BlurRadius is never clipped) -->
        <Ellipse Width="64" Height="64"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Stroke="#0090FF"
                 StrokeThickness="2.5"
                 Fill="#D814161C">
            <Ellipse.Effect>
                <DropShadowEffect Color="#00A2FF" BlurRadius="14" ShadowDepth="0" Opacity="0.95" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- Inner Target Ring -->
        <Ellipse Width="40" Height="40"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Stroke="#40A0FF"
                 StrokeThickness="1.5"
                 StrokeDashArray="3 2" />

        <!-- Crosshair Reticle Lines (Center at 48, 48) -->
        <Line X1="48" Y1="20" X2="48" Y2="38"
              Stroke="#00D2FF" StrokeThickness="2" StrokeEndLineCap="Round" />
        <Line X1="48" Y1="58" X2="48" Y2="76"
              Stroke="#00D2FF" StrokeThickness="2" StrokeEndLineCap="Round" />
        <Line X1="20" Y1="48" X2="38" Y2="48"
              Stroke="#00D2FF" StrokeThickness="2" StrokeEndLineCap="Round" />
        <Line X1="58" Y1="48" X2="76" Y2="48"
              Stroke="#00D2FF" StrokeThickness="2" StrokeEndLineCap="Round" />

        <!-- Bullseye Center Dot -->
        <Ellipse Width="8" Height="8"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="#FF3344">
            <Ellipse.Effect>
                <DropShadowEffect Color="#FF3344" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
            </Ellipse.Effect>
        </Ellipse>
    </Grid>
</Window>
