<Window x:Class="RevoSharp.App.Views.Hunter.HunterTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="猎犬模式准星"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="68"
        Height="68"
        WindowStartupLocation="Manual"
        ToolTip="猎犬模式准星&#x0a;• 长按拖拽并释放到任意窗口/弹窗&#x0a;• 单击激活全局瞄准镜&#x0a;• 双击返回主界面&#x0a;• 右键查看菜单">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="返回主界面" Click="OnRestoreMainClick" />
            <Separator />
            <MenuItem Header="不透明度 100%" Click="OnOpacity100Click" />
            <MenuItem Header="不透明度 75%" Click="OnOpacity75Click" />
            <MenuItem Header="不透明度 50%" Click="OnOpacity50Click" />
            <Separator />
            <MenuItem Header="退出猎犬模式" Click="OnExitHunterClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Cursor="Hand">
        <!-- Outer Glow Ring -->
        <Ellipse Width="64" Height="64"
                 Stroke="#0080FF"
                 StrokeThickness="2.5"
                 Fill="#CC14161C">
            <Ellipse.Effect>
                <DropShadowEffect Color="#00A2FF" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- Inner Target Ring -->
        <Ellipse Width="40" Height="40"
                 Stroke="#40A0FF"
                 StrokeThickness="1.5"
                 StrokeDashArray="3 2" />

        <!-- Crosshair Reticle Lines -->
        <!-- Top vertical line -->
        <Line X1="34" Y1="6" X2="34" Y2="24"
              Stroke="#00D2FF" StrokeThickness="2" StrokeEndLineCap="Round" />
        <!-- Bottom vertical line -->
        <Line X1="34" Y1="44" X2="34" Y2="62"
              Stroke="#00D2FF" StrokeThickness="2" StrokeEndLineCap="Round" />
        <!-- Left horizontal line -->
        <Line X1="6" Y1="34" X2="24" Y2="34"
              Stroke="#00D2FF" StrokeThickness="2" StrokeEndLineCap="Round" />
        <!-- Right horizontal line -->
        <Line X1="44" Y1="34" X2="62" Y2="34"
              Stroke="#00D2FF" StrokeThickness="2" StrokeEndLineCap="Round" />

        <!-- Bullseye Center Dot -->
        <Ellipse Width="8" Height="8" Fill="#FF3344">
            <Ellipse.Effect>
                <DropShadowEffect Color="#FF3344" BlurRadius="6" ShadowDepth="0" Opacity="0.9" />
            </Ellipse.Effect>
        </Ellipse>
    </Grid>
</Window>
