<ui:FluentWindow x:Class="RevoSharp.App.Views.MonitorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:RevoSharp.App.ViewModels"
        xmlns:conv="clr-namespace:RevoSharp.App.Converters"
        mc:Ignorable="d"
        Title="实时安装监控向导 (v2.4 Pro)"
        Height="660" Width="920"
        MinHeight="500" MinWidth="720"
        AllowDrop="True"
        DragOver="OnDialogDragOver"
        Drop="OnDialogFileDrop"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <conv:InverseBoolConverter x:Key="InvBool" />
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.DataContext>
        <vm:MonitorViewModel x:Name="ViewModel" />
    </ui:FluentWindow.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="实时安装监控向导 (v2.4 Pro)"
                     ShowMaximize="True"
                     ShowMinimize="False"
                     Icon="{ui:SymbolIcon Record24}">
            <ui:TitleBar.Header>
                <TextBlock Text="支持直接拖入 .exe / .msi 安装包 · ETW 内核追踪 · KCB 句柄精准还原"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 2. Configuration Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Margin="16,0,16,10"
                Padding="16,12"
                CornerRadius="8">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="安装包路径：" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Grid.Column="1"
                                PlaceholderText="请选择、粘贴或直接拖入安装包文件 (.exe / .msi / .msp)..."
                                Text="{Binding InstallerPath, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsMonitoring, Converter={StaticResource InvBool}}"
                                Margin="0,0,8,0" />
                    <ui:Button Grid.Column="2"
                               Content="浏览安装包..."
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding BrowseInstallerCommand}"
                               IsEnabled="{Binding IsMonitoring, Converter={StaticResource InvBool}}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="程序识别名称：" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Grid.Column="1"
                                Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="留空或自定义，安装完成后将自动匹配注册表新增软件名"
                                IsEnabled="{Binding IsMonitoring, Converter={StaticResource InvBool}}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Monitoring Real-Time Console & Metric Cards -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Margin="16,0,16,10"
                CornerRadius="8"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 4 Live Telemetry Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Document24" FontSize="20" Foreground="{DynamicResource RevoAccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="新建/写入文件" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding CapturedFiles}" FontSize="17" FontWeight="Bold" FontFamily="Consolas, Microsoft YaHei UI" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Code24" FontSize="20" Foreground="{DynamicResource RevoAccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="注册表键/值变更" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding CapturedRegistry}" FontSize="17" FontWeight="Bold" FontFamily="Consolas, Microsoft YaHei UI" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="20" Foreground="{DynamicResource RevoAccentPurpleBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="追踪进程树节点" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding TrackedProcesses}" FontSize="17" FontWeight="Bold" FontFamily="Consolas, Microsoft YaHei UI" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="6" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Clock24" FontSize="20" Foreground="{DynamicResource RevoAccentAmberBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="监控持续时间" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ElapsedTimeDisplay}" FontSize="17" FontWeight="Bold" FontFamily="Consolas, Microsoft YaHei UI" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Stream Filter & Control Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0"
                                PlaceholderText="过滤实时捕获路径或键名..."
                                Text="{Binding EventFilterText, UpdateSourceTrigger=PropertyChanged}"
                                Icon="{ui:SymbolIcon Search24}"
                                ClearButtonEnabled="True"
                                FontSize="12" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0" />
                        <TextBlock Text="ETW 内核监听运行中（支持 180ms 环形缓冲节流刷新，零 UI 阻塞）"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button Content="{Binding PauseStreamButtonText}"
                                   Command="{Binding TogglePauseStreamCommand}"
                                   FontSize="12"
                                   Padding="10,4"
                                   Margin="0,0,6,0" />
                        <ui:Button Content="清空画面"
                                   Command="{Binding ClearEventsCommand}"
                                   FontSize="12"
                                   Padding="10,4" />
                    </StackPanel>
                </Grid>

                <!-- Live Events List -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding RecentEvents}"
                         Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}"
                         BorderThickness="0"
                         FontFamily="Consolas, Cascadia Code, Microsoft YaHei UI"
                         FontSize="11.5" />
            </Grid>
        </Border>

        <!-- 4. Footer Actions -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="关闭" Margin="0,0,8,0" Click="OnCloseClick" />

                    <ui:Button Content="开始监视安装"
                               Icon="{ui:SymbolIcon Play24}"
                               Appearance="Primary"
                               Command="{Binding StartMonitoringCommand}"
                               Visibility="{Binding IsMonitoring, Converter={StaticResource InvBoolToVis}}" />

                    <ui:Button Content="试运行新软件 (捕获首次启动配置)"
                               Icon="{ui:SymbolIcon Rocket24}"
                               Margin="0,0,8,0"
                               Command="{Binding LaunchDetectedAppCommand}"
                               Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}"
                               ToolTip="安装向导完成后点击此按钮启动一次新软件再关闭，可将首次运行生成的 AppData 与注册表一并记入日志" />

                    <ui:Button Content="完成安装并保存日志"
                               Icon="{ui:SymbolIcon Checkmark24}"
                               Appearance="Success"
                               Click="OnSaveClick"
                               Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
